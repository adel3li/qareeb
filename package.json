{
  "name": "qareeb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build-content && vite",
    "build-content": "bun scripts/build-content.ts",
    "build": "bun run validate-content && bun run build-content && vite build",
    "preview": "vite preview --port 4173",
